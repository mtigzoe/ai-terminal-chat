# Which backend answers /chat and /stream: gemini (default), ollama, or kilo.
PROVIDER=gemini
PORT=9000

# --- gemini ---
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- ollama (local, no key needed) ---
# Same machine: http://localhost:11434/v1
# Remote Linux Ollama server: http://<linux-host>:11434/v1
# For a Windows backend talking to Linux, use the Linux hostname or LAN IP.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# --- kilo ---
# Get your Kilo gateway API key from: https://app.kilo.ai
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODEL=kilocode/kilo-auto/balanced
KILO_TIMEOUT=120
