# Which backend answers /chat and /stream:
# gemini (default), ollama, kilo, openai, xai, or openrouter.
PROVIDER=gemini
PORT=9000

# --- gemini ---
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- ollama (local, no key needed) ---
# Same machine: http://localhost:11434/v1
# Remote Linux Ollama server: http://<linux-host>:11434/v1
# For a Windows backend talking to Linux, use the Linux hostname or LAN IP.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# --- kilo ---
# Get your Kilo gateway API key from: https://app.kilo.ai
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODEL=kilocode/kilo-auto/balanced
KILO_TIMEOUT=120

# --- openai ---
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY is never exposed to the React frontend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# --- xai ---
# Get your xAI API key from: https://console.x.ai
# XAI_API_KEY is never exposed to the React frontend.
# Provider id is "xai"; Grok is the model family (default: grok-4.6).
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_TIMEOUT=120

# --- openrouter (gateway to many upstream models) ---
# Get your OpenRouter API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY is never exposed to the React frontend.
# OPENROUTER_MODEL is an opaque slug (e.g. openai/gpt-4o, anthropic/claude-sonnet-4)
# and is passed through to OpenRouter unchanged.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT=120
# Optional attribution headers for openrouter.ai rankings (not required).
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
